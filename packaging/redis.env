# Environment variables for redis-conflated-pubsub.service.
#
# systemd reads this file as root before the service starts, so the unit file
# never holds credentials. Reference a variable by name from the JSON config
# (never inline the secret itself), for example:
#
#   "input":   { "redis": { "password_env": "REDIS_INPUT_PASSWORD" } }
#   "outputs": { "output0": { "redis": { "password_env": "REDIS_OUTPUT0_PASSWORD" } } }
#
# Keep this file readable only by root (0640 root:root at most) and reload the
# service after changing it:
#
#   sudo systemctl restart redis-conflated-pubsub.service
#
# REDIS_INPUT_PASSWORD=
# REDIS_OUTPUT0_PASSWORD=

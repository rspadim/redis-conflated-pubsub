{
  "max_bytes_per_exec": 4194304,
  "input": {
    "redis": {
      "host": "redis-raw",
      "port": 6379,
      "database": 0
    },
    "filters": [
      {"glob": "hot:*", "action": "accept"}
    ],
    "filter_cache_max_entries": 16384,
    "filter_default": "accept",
    "subscriptions": [
      {
        "type": "psubscribe",
        "pattern": "hot:*",
        "output_prefix": "mapped:",
        "output_suffix": ":source"
      }
    ]
  },
  "outputs": {

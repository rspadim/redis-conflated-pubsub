        {"glob": "replica-a:mapped:hot:tenant-08:*:source:dest", "conflation.interval_ms": 0, "deduplication.ttl_ms": 0},
        {"glob": "replica-a:mapped:hot:tenant-09:*:source:dest", "conflation.interval_ms": 0, "deduplication.ttl_ms": 0},

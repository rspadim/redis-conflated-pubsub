{
  "max_bytes_per_exec": 4194304,
  "oversized_message_policy": "send",
  "input": {
    "redis": {
      "host": "localhost",
      "port": 6379,
      "username": null,
      "password_env": null,
      "tls": false,
      "database": 0,
      "connect_timeout_ms": 5000
    },
    "exclude_output_echoes": true,
    "exclude_sentinel_pubsub": true,
    "subscriptions": [
      {
        "type": "psubscribe",
        "pattern": "*",
        "output_prefix": "",
        "output_suffix": ""
      }
    ]
  },
  "outputs": {
    "output0": {
      "redis": {
        "host": "localhost",
        "port": 6379,
        "username": null,
        "password_env": null,
        "tls": false,
        "database": 0,
        "connect_timeout_ms": 5000
      },
      "channel_prefix": "db0:",
      "channel_suffix": "",
      "conflation": {
        "interval_ms": 0,
        "max_commands_per_exec": 256,
        "oversized_message_policy": "send"
      },
      "deduplication": {
        "ttl_ms": 5000
      }
    },
    "output1": {
      "redis": {
        "host": "localhost",
        "port": 6379,
        "username": null,
        "password_env": null,
        "tls": false,
        "database": 1,
        "connect_timeout_ms": 5000
      },
      "channel_prefix": "db1:",
      "channel_suffix": "",
      "conflation": {
        "interval_ms": 250,
        "max_commands_per_exec": 256,
        "max_bytes_per_exec": 2097152,
        "oversized_message_policy": "send"
      },
      "deduplication": {
        "ttl_ms": 5000
      },
      "deduplication_groups": {
        "shared-events": {
          "ttl_ms": 5000,
          "round_ms": 1000,
          "restart_on_change": false,
          "max_members": 16384,
          "max_cache_bytes": 67108864
        }
      },
      "profiles": {
        "fast-shared": {
          "conflation.interval_ms": 200,
          "deduplication.group": "shared-events"
        },
        "steady-shared": {
          "conflation.interval_ms": 250,
          "deduplication.group": "shared-events"
        },
        "independent-ttl": {
          "conflation.interval_ms": 250,
          "deduplication.ttl_ms": 1000
        },
        "fallback": {
          "conflation.interval_ms": 250,
          "deduplication.ttl_ms": 5000
        }
      },
      "channel_policies": [
        {
          "glob": "db1:events:sibling-fast:*",
          "profile": "fast-shared"
        },
        {
          "glob": "db1:events:sibling-standard:*",
          "profile": "steady-shared"
        },
        {
          "glob": "db1:events:independent:*",
          "profile": "independent-ttl"
        },
        {
          "glob": "db1:events:inline:*",
          "conflation.interval_ms": 300,
          "deduplication.ttl_ms": 1500
        },
        {
          "default": true,
          "profile": "fallback"
        }
      ]
    }
  },
  "instance_lock": {
    "path": "redis-conflated-pubsub.lock"
  },
  "status": {
    "http": {
      "bind": "127.0.0.1",
      "port": 9090
    }
  },
  "logging": {
    "directory": "logs",
    "level": "info",
    "retention_days": 14,
    "max_total_size_mb": 1024
  }
}

# syntax=docker/dockerfile:1.7
FROM rust:1.99.0-alpine3.22 AS builder

RUN apk add --no-cache build-base musl-dev perl

WORKDIR /build

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src ./src
COPY examples ./examples

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/build/target,sharing=locked \
    rustup target add x86_64-unknown-linux-musl \
    && cargo build --release --locked --target x86_64-unknown-linux-musl \
        --example hotpath_benchmark \
        --example hotpath_mix_benchmark \
        --example loopback_benchmark \
    && mkdir -p /out \
    && cp target/x86_64-unknown-linux-musl/release/examples/hotpath_benchmark /out/ \
    && cp target/x86_64-unknown-linux-musl/release/examples/hotpath_mix_benchmark /out/ \
    && cp target/x86_64-unknown-linux-musl/release/examples/loopback_benchmark /out/

# Alpine keeps a shell for the `sh -c "exec ${HOTPATH_BENCHMARK_CMD}"` entrypoint.
FROM alpine:3.22

COPY --from=builder /out/hotpath_benchmark /usr/local/bin/hotpath-benchmark
COPY --from=builder /out/hotpath_mix_benchmark /usr/local/bin/hotpath-mix-benchmark
COPY --from=builder /out/loopback_benchmark /usr/local/bin/loopback-benchmark

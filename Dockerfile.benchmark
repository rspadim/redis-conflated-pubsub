# syntax=docker/dockerfile:1.7
FROM rust:1.99.0-alpine3.22 AS builder

RUN apk add --no-cache build-base musl-dev perl

WORKDIR /build

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src ./src
COPY examples ./examples

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/build/target,sharing=locked \
    rustup target add x86_64-unknown-linux-musl \
    && cargo build --release --locked --target x86_64-unknown-linux-musl --example hotpath_benchmark \
    && mkdir -p /out \
    && cp target/x86_64-unknown-linux-musl/release/examples/hotpath_benchmark /out/

# Python stays in the final stage so the mixed-policy benchmark
# (python /tests/docker_hotpath_policy_mix.py) can run in the same image.
FROM python:3.13-alpine

COPY --from=builder /out/hotpath_benchmark /usr/local/bin/hotpath-benchmark

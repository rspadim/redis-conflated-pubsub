# Single-container bundle for docker run deployments. The regular Dockerfile
# remains the smaller relay-only image intended for multi-container setups.
# syntax=docker/dockerfile:1.7
FROM rust:1.99.0-alpine3.22 AS builder

RUN apk add --no-cache build-base musl-dev perl

WORKDIR /build

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src ./src

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/build/target,sharing=locked \
    rustup target add x86_64-unknown-linux-musl \
    && cargo build --release --locked --target x86_64-unknown-linux-musl \
    && mkdir -p /out \
    && cp target/x86_64-unknown-linux-musl/release/redis-conflated-pubsub /out/

FROM alpine:3.22 AS runtime

RUN apk add --no-cache bash tini redis valkey \
    && addgroup -S relay \
    && adduser -S -G relay relay \
    && mkdir -p /data/raw /data/conflated /state /etc/redis-conflated \
    && chown -R relay:relay /data /state /etc/redis-conflated

COPY --from=builder /out/redis-conflated-pubsub /usr/local/bin/redis-conflated-pubsub
COPY docker/bundle-entrypoint.sh /usr/local/bin/bundle-entrypoint.sh
COPY docker/bundle-healthcheck.sh /usr/local/bin/bundle-healthcheck.sh

ENV KV_ENGINE=redis \
    CONFIG_FILE=/etc/redis-conflated/config.json

# Select the server implementation at container runtime, not build time:
#   docker run -e KV_ENGINE=redis  ...
#   docker run -e KV_ENGINE=valkey ...
# The default is Redis. The selected implementation runs both instances
# (raw:6379 and conflated:6380); the relay reads CONFIG_FILE for its endpoints.

VOLUME ["/data/raw", "/data/conflated", "/state"]
EXPOSE 6379 6380
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 \
    CMD ["/bin/bash", "/usr/local/bin/bundle-healthcheck.sh"]

USER relay
ENTRYPOINT ["/sbin/tini", "--", "/bin/bash", "/usr/local/bin/bundle-entrypoint.sh"]
